			"contents": "function updateCurrentResolutionSize(item = null) {\n\n    let value;\n\n    /**\n     * Clique em item do dropdown\n     */\n    if(item) {\n\n        const currentValue = state.previewBreakpoint;\n        value = $(item).data('value');\n\n        /**\n         * Se já está ativo apenas fecha dropdown\n         */\n        if(currentValue === value) {\n\n            const dropdownEl = document.querySelector(\n                '#automator-editor-dropdown'\n            );\n\n            if(dropdownEl) {\n\n                const dropdown =\n                    bootstrap.Dropdown.getInstance(\n                        dropdownEl.querySelector(\n                            '.dropdown-toggle'\n                        )\n                    );\n\n                if(dropdown) {\n                    dropdown.hide();\n                }\n\n            }\n\n            return;\n\n        }\n\n        state.previewBreakpoint = value;\n\n    } else {\n\n        value =\n            state.previewBreakpoint ||\n            'col-xxl-';\n\n    }\n\n    /**\n     * Atualiza itens ativos\n     */\n    $('#automator-editor-dropdown .dropdown-item')\n        .removeClass('active');\n\n    const activeItem =\n        $('#automator-editor-dropdown .dropdown-item[data-value=\"' + value + '\"]');\n\n    activeItem.addClass('active');\n\n    /**\n     * Atualiza botão principal\n     */\n    const button =\n        $('#automator-editor-dropdown .dropdown-toggle');\n\n    const icon =\n        activeItem.find('i').prop('outerHTML');\n\n    const title =\n        $.trim(\n            activeItem.text()\n        );\n\n    button.find('span').html(icon);\n\n    button.find('span')\n        .attr(\n            'data-bs-title',\n            title\n        )\n        .attr(\n            'data-bs-original-title',\n            title\n        );\n\n    /**\n     * Recria tooltip\n     */\n    const tooltipEl =\n        button.find('span')[0];\n\n    const tooltip =\n        bootstrap.Tooltip.getInstance(\n            tooltipEl\n        );\n\n    if(tooltip) {\n        tooltip.dispose();\n    }\n\n    new bootstrap.Tooltip(\n        tooltipEl\n    );\n\n    /**\n     * Atualiza preview das colunas\n     */\n    $(selectors.canvas)\n        .find('.wp-block')\n        .each(function(){\n\n            const block = $(this);\n\n            /**\n             * Remove previews antigos\n             */\n            this.className =\n                this.className\n                    .split(' ')\n                    .filter(function(cls){\n\n                        return !cls.startsWith(\n                            'preview-col'\n                        );\n\n                    })\n                    .join(' ');\n\n            let attrName = '';\n\n            switch(value) {\n\n                case 'col-':\n                    attrName = 'data-col';\n                    break;\n\n                case 'col-sm-':\n                    attrName = 'data-col-sm';\n                    break;\n\n                case 'col-md-':\n                    attrName = 'data-col-md';\n                    break;\n\n                case 'col-lg-':\n                    attrName = 'data-col-lg';\n                    break;\n\n                case 'col-xl-':\n                    attrName = 'data-col-xl';\n                    break;\n\n                default:\n                    attrName = 'data-col-xxl';\n                    break;\n\n            }\n\n            let size =\n                block.attr(attrName);\n\n            if(\n                !size ||\n                size === ''\n            ) {\n\n                size = 12;\n\n            }\n\n            block.addClass(\n                'preview-col-' + size\n            );\n\n        });\n\n    /**\n     * Evento opcional\n     */\n    if(typeof trigger === 'function') {\n\n        trigger(\n            'resolution:changed',\n            {\n                breakpoint: value\n            }\n        );\n\n    }\n\n}\n\n\n\nfunction changeColClassSize(\n    item,\n    size\n){\n\n    const el = $(item);\n\n    const id =\n        el.attr(\n            'data-block'\n        );\n\n    const valor =\n        el.val();\n\n    const bloco =\n        $(selectors.canvas)\n            .find(\n                \".wp-block[data-id='\" +\n                id +\n                \"']\"\n            );\n\n    if(!bloco.length){\n        return;\n    }\n\n    let attr = '';\n\n    switch(size){\n\n        case 'col-':\n\n            attr = 'data-col';\n            break;\n\n        case 'col-sm-':\n\n            attr = 'data-col-sm';\n            break;\n\n        case 'col-md-':\n\n            attr = 'data-col-md';\n            break;\n\n        case 'col-lg-':\n\n            attr = 'data-col-lg';\n            break;\n\n        case 'col-xl-':\n\n            attr = 'data-col-xl';\n            break;\n\n        case 'col-xxl-':\n\n            attr = 'data-col-xxl';\n            break;\n\n    }\n\n    bloco.attr(\n        attr,\n        valor\n    );\n\n    updateCurrentResolutionSize();\n\n  }",
