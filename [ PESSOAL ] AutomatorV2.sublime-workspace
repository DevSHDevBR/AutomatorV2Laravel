tip.getInstance(\n            tooltipEl\n        );\n\n    if(tooltip) {\n        tooltip.dispose();\n    }\n\n    new bootstrap.Tooltip(\n        tooltipEl\n    );\n\n    /**\n     * Atualiza preview das colunas\n     */\n    $(selectors.canvas)\n        .find('.wp-block')\n        .each(function(){\n\n            const block = $(this);\n\n            /**\n             * Remove previews antigos\n             */\n            this.className =\n                this.className\n                    .split(' ')\n                    .filter(function(cls){\n\n                        return !cls.startsWith(\n                            'preview-col'\n                        );\n\n                    })\n                    .join(' ');\n\n            let attrName = '';\n\n            switch(value) {\n\n                case 'col-':\n                    attrName = 'data-col';\n                    break;\n\n                case 'col-sm-':\n                    attrName = 'data-col-sm';\n                    break;\n\n                case 'col-md-':\n                    attrName = 'data-col-md';\n                    break;\n\n                case 'col-lg-':\n                    attrName = 'data-col-lg';\n                    break;\n\n                case 'col-xl-':\n                    attrName = 'data-col-xl';\n                    break;\n\n                default:\n                    attrName = 'data-col-xxl';\n                    break;\n\n            }\n\n            let size =\n                block.attr(attrName);\n\n            if(\n                !size ||\n                size === ''\n            ) {\n\n                size = 12;\n\n            }\n\n            block.addClass(\n                'preview-col-' + size\n            );\n\n        });\n\n    /**\n     * Evento opcional\n     */\n    if(typeof trigger === 'function') {\n\n        trigger(\n            'resolution:changed',\n            {\n                breakpoint: value\n            }\n        );\n\n    }\n\n}\n\n\n\nfunction changeColClassSize(\n    item,\n    size\n){\n\n    const el = $(item);\n\n    const id =\n        el.attr(\n            'data-block'\n        );\n\n    const valor =\n        el.val();\n\n    const bloco =\n        $(selectors.canvas)\n            .find(\n                \".wp-block[data-id='\" +\n                id +\n                \"']\"\n            );\n\n    if(!bloco.length){\n        return;\n    }\n\n    let attr = '';\n\n    switch(size){\n\n        case 'col-':\n\n            attr = 'data-col';\n            break;\n\n        case 'col-sm-':\n\n            attr = 'data-col-sm';\n            break;\n\n        case 'col-md-':\n\n            attr = 'data-col-md';\n            break;\n\n        case 'col-lg-':\n\n            attr = 'data-col-lg';\n            break;\n\n        case 'col-xl-':\n\n            attr = 'data-col-xl';\n            break;\n\n        case 'col-xxl-':\n\n            attr = 'data-col-xxl';\n            break;\n\n    }\n\n    bloco.attr(\n        attr,\n        valor\n    );\n\n    updateCurrentResolutionSize();\n\n  }",
