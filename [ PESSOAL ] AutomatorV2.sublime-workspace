			"contents": "editor-scripts.js\n/**\n * AUTOMATOR PAGE EDITOR SCRIPT - VERSION 4.3 (CRITICAL FIXES)\n * Sistema de blocos dinâmicos com suporte a aninhamento, persistência de propriedades e Sortable total.\n */\n\nwindow.SysAutomatorEditor = (function() {\n\n\n\n\n  const defaultState = {\n\n    activeBlock:       null,\n    isNew:             true,\n    hasChanges:        false,\n    previewBreakpoint: 'col-xxl-',\n    argCount:          0,\n    blockConfigs:      {},\n\n  };\n\n\n\n  let state = {\n\n    activeBlock:       null,\n    isNew:             true,\n    hasChanges:        false,\n    previewBreakpoint: 'col-xxl-',\n    argCount:          0,\n    blockConfigs:      {}\n\n  };\n\n\n\n  const defaultEditor = {\n\n    defalutEmpty:  {\n      text:   'Digite um texto para o bloco.',\n      editor: 'Digite um conteudo para o bloco.',\n      block:  'Adicione um conteudo a este bloco.',\n    },\n    defalutAdd:  {\n      text:   'Digite o texto para o bloco.',\n      editor: 'Adicione o conteudo para o bloco.',\n      block:  'Adicionar conteudo ao bloco.',\n    },\n    defaultText:   {\n      \n      selectBlock:   'Selecione um bloco para editar',\n      noBlocksAdded: 'Nenhum bloco adicionado.'\n\n    },\n    addBlockBTN:   'Adicionar bloco',\n    blocskBTN:     'Blocos',\n    settingsBlock: {\n\n        collapsed: false,\n        tab: 'page-settings'\n\n    },\n    content: '',\n    blocks: {}\n\n\n  };\n\n\n\n  let editor = $.extend(\n\n    true,\n    {},\n    defaultEditor\n\n  );\n\n\n\n  const selectors = {\n\n    resolutions:    '#automator-editor-header-resolutions-dropdown',\n    configs:        '#automator-editor-header-configs-button',\n    save:           '#automator-editor-header-save-button',\n    leftAside:      '#automator-editor-aside-left',\n    inserterBlock:  '#automator-editor-aside-left-inserter',\n    inserterList:   '#automator-editor-aside-left-inserter-list',\n    structureBlock: '#automator-editor-aside-left-structure',\n    structureList:  '#automator-editor-aside-left-structure-list',\n    rightAside:     '#automator-editor-aside-right',\n    canvas:         '#automator-editor-canvas-container-content',\n    actions:        '.automator-editor-actions-button'\n  \n  };\n\n\n\n  let interfaceInitialized = false;\n\n  let contadorBlocos = 0;\n  \n\n\n  // function on(event, callback) {\n\n  //   if(typeof callback !== 'function') {\n\n  //     return;\n\n  //   }\n\n\n  //   if(!state.triggers[event]) {\n\n  //     state.triggers[event] = [];\n\n  //   }\n\n  //   state.triggers[event].push(callback);\n\n\n  // }\n\n\n\n  function destroy() {\n\n\n    $(selectors.canvas).empty();\n    \n    $(selectors.settingsBlock).html('<p class=\"text-muted text-center py-5 small\">'  + editor.defaultText.selectBlock +  '.</p>');\n    \n    $(selectors.structureList).html('<div class=\"text-muted text-center py-5 small\">' + editor.defaultText.noBlocksAdded + '</div>');\n    \n\n    state = $.extend(\n\n      true,\n      {},\n      defaultState\n    \n    );\n\n    \n    editor = $.extend(\n    \n      true,\n      {},\n      defaultEditor\n    \n    );\n\n\n    console.log('Editor destruído');\n\n    interfaceInitialized = false;\n\n\n  }\n\n\n\n  function config(data = {}) {\n\n    \n    editor = $.extend(\n      true,\n      {},\n      defaultEditor\n    );\n\n \n\n    if(typeof data.isNew !== 'undefined') {\n\n      state.isNew = data.isNew;\n\n    }\n\n    \n    if(data.editor) {\n\n      $.extend(\n        true,\n        editor,\n        data.editor\n      );\n\n    }\n\n\n  }\n\n  function updateStructureAndState() {\n\n    // 1. Extrai a estrutura real do DOM (quem é pai de quem e a ordem atual)\n    const newStructure = extractBlockStructure($(selectors.canvas));\n    \n    console.log(newStructure);\n    // 2. Limpa o cache atual para reconstruí-lo de forma limpa\n    // Nota: Se você quiser manter configurações específicas que não estão no DOM, \n    // precisará de uma lógica de merge mais complexa. Aqui focamos na estrutura.\n    state.blockConfigs = {};\n    \n    // 3. Atualiza a lista de estrutura na sidebar\n    const structureListContainer = $(selectors.structureList);\n    structureListContainer.empty();\n    \n    if (newStructure.length >= 1) {\n        generateStructureList(newStructure, structureListContainer);\n        // console.log(\"State atualizado após mudança:\", state.blockConfigs);\n    } else {\n        structureListContainer.html('<div class=\"text-center text-muted p-2\">' + \n            (($(selectors.structureList).attr('data-empty')) ? \n            ($(selectors.structureList).attr('data-empty') != \"\" ? $(selectors.structureList).attr('data-empty') : editor.defaultText.noBlocksAdded) : \n            editor.defaultText.noBlocksAdded) + '</div>');\n    }\n\n    // Opcional: Salva o HTML reconstruído se necessário para persistência imediata\n    // const reconstructedHtmlString = reconstructHtml(newStructure);\n    // state.hasChanges = true;\n  }\n\n  function deleteBlock(id) {\n    const block = document.getElementById(id);\n    if (!block) return;\n    \n    if (block.getAttribute('data-block-locked') === 'true') {\n        alert('Este bloco está bloqueado.');\n        return;\n    }\n\n    if (confirm('Deseja excluir este bloco?')) {\n        $(block).remove();\n        // DISPARA A SINCRONIZAÇÃO\n        updateStructureAndState();\n        // Se houver lógica de deselecionar:\n        // SysAutomatorEditor.deselectAll();\n    }\n  }\n\n\n\n  function init(callback = null) {\n\n\n    console.log('Editor start!');\n\n    // console.log(editor);\n    $(selectors.canvas).html(`\n\n      <div class=\"automator-editor-block container\" data-block-type=\"container\" data-block-locked=\"false\">\n\n        <div class=\"automator-editor-block row\" data-block-type=\"row\" data-block-locked=\"false\">\n\n          <div class=\"automator-editor-block col col-12 col-md-6\" data-block-type=\"col\" data-block-locked=\"true\">\n\n            <p class=\"automator-editor-block\" data-block-type=\"paragraph\" data-block-locked=\"false\">Texto</p>\n            <p class=\"automator-editor-block\" data-block-type=\"paragraph\" data-block-locked=\"false\">Texto2</p>\n            <p class=\"automator-editor-block\" data-block-type=\"paragraph\" data-block-locked=\"true\">Texto3</p>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    `);\n\n    const extractedStructure = extractBlockStructure($(selectors.canvas));\n    \n    $(\"#extracted-json\").text(JSON.stringify(extractedStructure, null, 2));\n\n    const reconstructedHtmlString = reconstructHtml(extractedStructure);\n    $(selectors.canvas).html(reconstructedHtmlString);\n\n    const structureListContainer = $(selectors.structureList);\n    structureListContainer.empty(); // Limpar antes de gerar\n    if (extractedStructure.length >= 1) {\n\n      contadorBlocos = 0;\n      generateStructureList(extractedStructure, structureListContainer);\n      console.log(state);\n      // initSortable(document.querySelector(selectors.canvas));\n\n    } else {\n      structureListContainer.html('<div class=\"text-center text-muted p-2\">' + ( ($(selectors.structureList).attr('data-empty')) ? ( ($(selectors.structureList).attr('data-empty') != \"\") ? $(selectors.structureList).attr('data-empty') : editor.defalutEmpty.noBlocksAdded ) : editor.defalutEmpty.noBlocksAdded ) + '</div>');\n    }\n    // $(selectors.canvas).html('');\n\n    // var tree = extractBlockStructure($(selectors.canvas));\n\n    // $(selectors.structureList).html('');\n    // if(tree.length >= 1) {\n      \n    //   generateStructureList(tree, $(selectors.structureList));\n\n    // } else {\n\n    //   $(selectors.structureList).html('<div class=\"text-center text-muted p-2\">' + ( ($(selectors.structureList).attr('data-empty')) ? ( ($(selectors.structureList).attr('data-empty') != \"\") ? $(selectors.structureList).attr('data-empty') : editor.defalutEmpty.noBlocksAdded ) : editor.defalutEmpty.noBlocksAdded ) + '</div>');\n\n    // }\n\n\n\n  }\n\n  function generateStructureList(items, $container, level = 0) {\n    items.forEach(block => {\n        const blockType = $(selectors.inserterList + \" .automator-editor-aside-left-inserter-list-item[data-block-type='\" + block.blockType + \"']\");\n        const title     = blockType.find('span').text() || `Bloco`;\n        const icon      = blockType.attr('data-block-icon') || 'cube';\n        const id        = block.id;\n        const isLocked  = (block.attributes['data-block-locked'] == 'true');\n\n        // IMPORTANTE: Alimenta o state com a configuração do bloco\n        state.blockConfigs[id] = block;\n\n        const itemHtml = `\n            <div class=\"automator-editor-aside-left-structure-list-item d-flex align-items-center p-2 border-bottom\" data-block-id=\"${id}\" data-block-type=\"${block.blockType}\" style=\"padding-left: ${level * 20 + 10}px !important;\">\n                <i class=\"fas fa-grip-vertical automator-editor-aside-left-structure-list-item-handle me-2 text-muted\"></i>\n                <i class=\"fa fa-${icon} me-2 small text-primary\"></i>\n                <span class=\"small flex-grow-1 text-truncate cursor-pointer\" onclick=\"SysAutomatorEditor.scrollToBlock('${id}')\">\n                    ${title} ${isLocked ? '<i class=\"fas fa-lock ms-1 text-warning\"></i>' : ''}\n                </span>\n                <button type=\"button\" class=\"btn btn-xs btn-light\" onclick=\"SysAutomatorEditor.toggleLock('${id}'); event.stopPropagation();\">\n                    <i class=\"fas ${isLocked ? 'fa-lock' : 'fa-lock-open'}\"></i>\n                </button>\n                <button type=\"button\" class=\"btn btn-xs btn-light text-danger ms-1\" onclick=\"SysAutomatorEditor.deleteBlock('${id}'); event.stopPropagation();\">\n                    <i class=\"fas fa-trash\"></i>\n                </button>\n            </div>\n        `;\n        \n        $container.append(itemHtml);\n\n        if (block.children && block.children.length > 0) {\n            generateStructureList(block.children, $container, level + 1);\n        }\n    });\n  }\n  // function updateStructureList() {\n\n  //    const extractedStructure = extractBlockStructure($(selectors.canvas));\n    \n  //     $(\"#extracted-json\").text(JSON.stringify(extractedStructure, null, 2));\n\n  //     const reconstructedHtmlString = reconstructHtml(extractedStructure);\n  //     $(selectors.canvas).html(reconstructedHtmlString);\n\n  //     const structureListContainer = $(selectors.structureList);\n  //     structureListContainer.empty(); // Limpar antes de gerar\n  //     if (extractedStructure.length >= 1) {\n  //       generateStructureList(extractedStructure, structureListContainer);\n\n  //       // initSortable(document.querySelector(selectors.canvas));\n\n  //     } else {\n  //       structureListContainer.html('<div class=\"text-center text-muted p-2\">' + ( ($(selectors.structureList).attr('data-empty')) ? ( ($(selectors.structureList).attr('data-empty') != \"\") ? $(selectors.structureList).attr('data-empty') : editor.defalutEmpty.noBlocksAdded ) : editor.defalutEmpty.noBlocksAdded ) + '</div>');\n  //     }\n  // }\n\n  function renderFieldElement(id, field, value = null) {\n    let toolbarHTML = '';\n    let toolbarHTMLC = 0;\n\n    if (field.toolbar && Array.isArray(field.toolbar)) {\n        field.toolbar.forEach(btn => {\n            toolbarHTML += `<button type=\"${btn.type || 'button'}\" class=\"${btn.class}\" data-bs-toggle=\"tooltip\" data-bs-title=\"${btn.title}\" onclick=\"${btn.onclick}\">${btn.label}</button>`;\n            toolbarHTMLC++;\n        });\n    }\n\n    var renderArea  = '<div class=\"automator-editor-block-handle\"><i class=\"fas fa-grip-vertical\"></i></div>\\n';\n    renderArea += '<div class=\"automator-editor-block-toolbar\">\\n';\n      \n    if(toolbarHTMLC >= 1) {\n        renderArea += `${toolbarHTML}\\n`;\n        renderArea += '<div class=\