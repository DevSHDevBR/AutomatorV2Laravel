ata-bs-toggle=\"tooltip\" data-bs-title=\"Mover para baixo\"><i class=\"fas fa-chevron-down\"></i></button>` + \"\\n\";\n          renderArea += '<div class=\"vr mx-1\"></div>' + \"\\n\";\n          renderArea += `<button type=\"button\" id=\"lock-btn-${id}\" onclick=\"SysAutomatorEditor.toggleLock('${id}')\" class=\"btn btn-xs btn-light border lock-btn\" data-bs-toggle=\"tooltip\" data-bs-title=\"Travar/Destravar Campo\"><i class=\"fas fa-lock-open\"></i></button>` + \"\\n\";\n          renderArea += `<button type=\"button\" class=\"btn btn-xs btn-light border text-danger\" onclick=\"SysAutomatorEditor.deleteBlock('${id}')\" data-bs-toggle=\"tooltip\" data-bs-title=\"Excluir campo\"><i class=\"fas fa-times\"></i></button>` + \"\\n\";\n          renderArea += '<div class=\"vr mx-1\"></div>' + \"\\n\";\n          renderArea += `<button type=\"button\" class=\"btn btn-xs btn-light border\" onclick=\"SysAutomatorEditor.addBlock('${id}', 'before')\" data-bs-toggle=\"tooltip\" data-bs-title=\"Adicionar antes\"><i class=\"fa fa-plus\"></i><span style=\"font-size: 10px; position: relative; top: -6px; right: -5px;\"><i class=\"fa fa-angle-up\"></i></span></button>` + \"\\n\";\n          renderArea += `<button type=\"button\" class=\"btn btn-xs btn-light border\" onclick=\"SysAutomatorEditor.addBlock('${id}', 'after')\" data-bs-toggle=\"tooltip\" data-bs-title=\"Adicionar antes\"><i class=\"fa fa-plus\"></i><span style=\"font-size: 10px; position: relative; top: -6px; right: -5px;\"><i class=\"fa fa-angle-down\"></i></span></button>` + \"\\n\";\n\n\n        renderArea += '</div>' + \"\\n\";\n        renderArea += '<div class=\"automator-editor-block-render-area' + ( (field.class) ? ' ' + field.class : '' ) + '\">' + \"\\n\";\n        renderArea += '</div>' + \"\\n\";\n\n\n    if (field.can_have_child) {\n\n      renderArea += '<div class=\"automator-editor-block-add-child-btn\">' + \"\\n\";\n\n        renderArea += renderAddButton(id) + \"\\n\";\n\n      renderArea += '</div>' + \"\\n\";\n\n    };\n\n    return renderArea;\n    \n\n  }\n\n\n  function renderAddButton(block = '') {\n\n    return '<button type=\"button\" id=\"automator-editor-btn-child-' + block + '\" class=\"automator-editor-body-canvas-content-add-button\" onclick=\"event.stopPropagation(); SysAutomatorEditor.addChildBlock(this, \\'' + block + '\\')\">' + editor.addBlockBTN + '</button>';\n\n  }\n  // function renderAddButton(block = '') {\n\n  //   return '<button type=\"button\" id=\"automator-editor-btn-child-' + block + '\" class=\"automator-editor-body-canvas-content-add-button\" onclick=\"SysAutomatorEditor.addChildBlock(this, ' + \"'\" +  block + \"'\" + ')\">' +  editor.addBlockBTN + '</button>';\n\n  // }\n\n\n\n\n  function renderBlockSettings(block, blockID, field) {\n\n\n    if(!field) return;\n    \n    $('#automator-editor-body-aside-right-tabs-button-block').prop('disabled', false);\n    var blocks = field['properties'];\n\n    var blockHTML = `\n\n      <div class=\"row\">\n        \n        <div class=\"col-12 m-3\">\n          \n          <h6 class=\"fw-bold\"><i class=\"fa fa-${field['icon'] || 'cube'} me-2 d-inline-block small\"></i> ${field['title']}</h6>\n\n        </div>\n        <div class=\"col-12 m-3 mt-0 small text-muted\">${field['description'] || ''}</div>\n        <div class=\"col-12 mb-3\">\n          \n          <div class=\"accordion\" id=\"block-settings-rendered-${blockID}\">`;\n\n            $.each(blocks, function(blockKey, blockItem) {\n              \n              blockHTML += `\n              <div class=\"accordion-item\" style=\"border-radius: 0px !important;\">\n                <h2 class=\"accordion-header\">\n\n                  <button class=\"accordion-button collapsed\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#block-settings-rendered-${blockID}-${blockKey}\">${blockItem['label']}</button>\n                \n                </h2>\n                <div id=\"block-settings-rendered-${blockID}-${blockKey}\" class=\"accordion-collapse collapse\">\n                  <div class=\"accordion-body\">`;\n\n                    $.each(blockItem['fields'], function(fieldKey, fieldItem) {\n\n                      blockHTML += `<div class=\"col-12 mb-3\">${renderBlockSettingsField(blockID, blockKey, fieldKey, fieldItem)}</div>`;\n\n                    });\n\n                  blockHTML += `</div>`;\n\n                blockHTML += `</div>`;\n\n              blockHTML += `</div>`;\n\n            });\n\n          blockHTML += `</div>`;\n      \n      blockHTML += `</div>`;\n\n    blockHTML += `</div>`;\n    \n    $(selectors.settingsBlock).html(blockHTML);\n    switchTab('block');\n    \n    // initSettingsEvents(blockID);\n  \n\n  }\n\n\n\n  function renderBlockSettingsField(blockID, blockKey, fieldKey, fieldItem) {\n\n\n    const label = `<label class=\"form-label small fw-bold\">${fieldItem.label}</label>`;\n    const name  = `${blockKey}.${fieldKey}`;\n    const val   = fieldItem.default || '';\n    \n\n    switch(fieldItem.field) {\n\n      case 'color-picker':\n\n\n        return `\n          \n          <div class=\"d-flex align-items-center justify-content-between mb-2\">\n\n            <label class=\"small fw-bold\">${fieldItem.label}</label>\n            <div class=\"wp-editor-custom-color-picker\">\n\n              <input type=\"color\" name=\"${name}\" value=\"${val}\" data-block-id=\"${blockID}\" />\n\n            </div>\n\n          </div>\n\n        `;\n\n\n      case 'radio-buttons':\n        \n\n        let radios = `<div class=\"btn-group w-100\" role=\"group\">`;\n          \n          $.each(fieldItem.choices, function(k, v) {\n            \n            radios += `<input type=\"radio\" class=\"btn-check\" name=\"${name}\" id=\"btn-${blockID}-${k}\" value=\"${k}\" ${val === k ? 'checked' : ''} data-block=\"${blockID}\">\n                       <label class=\"btn btn-outline-secondary btn-sm\" for=\"btn-${blockID}-${k}\">${v}</label>`;\n          \n          });\n\n          radios += label;\n\n        radios += `</div>`;\n\n        return `${radios}`;\n\n\n      case 'select':\n        \n\n        let selects = `<div class=\"form-floating\">`;\n          \n          selects += `<select name=\"${name}\" class=\"form-select\" data-block=\"${blockID}\">`;\n          \n            $.each(fieldItem.choices, function(k, v) {\n          \n              selects += `<option value=\"${k}\" ${val === k ? 'selected' : ''}>${v}</option>`;\n          \n            });\n          \n          selects += `</select>`;\n\n          selects += label;\n        \n        selects += '</div>';\n\n        return `${selects}`;\n\n\n      case 'range':\n        \n\n        let oninput = 'SysAutomatorEditor.updateRangeInputViewValue(this)';\n        if(fieldItem.oninput) {\n\n          oninput = '' + fieldItem.oninput;\n\n        }\n\n        return `\n\n          <div class=\"row\">\n\n            <div class=\"col-8\">\n\n              ${label}\n              <input type=\"range\" class=\"form-range\" name=\"${name}\" value=\"${val}\" data-block-id=\"${blockID}\" min=\"${fieldItem.minval}\" max=\"${fieldItem.maxval}\" oninput=\"${oninput}\" />\n\n            </div>\n            <div class=\"col-4\">\n\n              <input type=\"number\" class=\"form-control form-control-sm\" name=\"${name}-value\" value=\"${val}\" data-block-id=\"${name}-${blockID}-value\" min=\"${fieldItem.minval}\" max=\"${fieldItem.maxval}\" />\n\n            </div>\n\n          </div>\n\n        `;\n\n\n      case 'textarea':\n      \n\n        return `\n\n          <div class=\"form-floating\">\n        \n            <textarea class=\"form-control form-control-sm\" name=\"${name}\" rows=\"5\" data-block-id=\"${blockID}\">${val}</textarea>\n            ${label}\n\n          </div>\n\n        `;\n      \n      default:\n        \n\n        return `\n\n          <div class=\"form-floating\">\n\n            <input type=\"text\" class=\"form-control form-control-sm\" name=\"${name}\" value=\"${val}\" data-block-id=\"${blockID}\" />\n            ${label}\n\n          </div>\n\n        `;\n\n\n    }\n\n\n  }\n\n\n\n  function deselectAll(defaultBlock = null) {\n\n\n    if(state.activeBlock) state.activeBlock.classList.remove('is-active');\n    state.activeBlock = null;\n\n    $(selectors.settingsBlock).prop('disabled', true);\n\n    if(defaultBlock != null) {\n\n      switchTab(defaultBlock);\n\n    } else {\n\n      var defaultTab = $(selectors.rightArea).find('.automator-editor-body-aside-right-tabs-button[data-automator-default=\"true\"]');\n      if(defaultTab.length >= 1) {\n\n\n        $(selectors.rightArea).find('.automator-editor-body-aside-right-tabs-button').prop('disabled', true).removeClass('active');\n\n        defaultTab.prop('disabled', false).addClass('active');\n        \n        var defaultTab = $(selectors.rightArea).find('.automator-editor-body-aside-right-tabs-container-items[data-automator-default=\"true\"]');\n        defaultTab.removeClass('d-none').addClass('active');\n\n        $(selectors.settingsBlock).html('<p>' + ($(selectors.settingsBlock).attr('data-default')) + '</p>').addClass('d-none');\n\n      }\n      // var buttons = rightArea.find(\"#automator-editor-body-aside-right-tabs > .automator-editor-body-aside-right-tabs-button\");\n      // if(buttons.length >= 2) {\n\n      // } else {\n\n      // }\n\n    }\n\n  \n  }\n\n\n\n  function switchTab(tab) {\n\n\n    $('.automator-editor-body-aside-right-tabs-button').removeClass('active');\n    $(`#automator-editor-body-aside-right-tabs-button-${tab}`).addClass('active');\n\n    $(`.automator-editor-body-aside-right-tabs-container-items`).addClass('d-none');\n    $(`#automator-editor-body-aside-right-tabs-container-${tab}`).removeClass('d-none');\n\n\n  }\n\n\n\n  return {\n\n    config,\n    init,\n    destroy,\n    initInterface,\n    toggleSidebar,\n    switchLeftTab,\n    switchTab,\n    deselectAll,\n    selectBlock,\n    addChildBlock,\n    insertField,\n    // updateRangeInputViewValue,\n    // SysAutomatorEditorIncludeField,\n    // updateCurrentResolutionSize,\n    // restoreCurrentResolutionSize,\n    // refreshCanvasBreakpoint,\n    // injectPreviewCSS,\n    // moveBlock,\n    // toggleLock,\n    // deleteBlock,\n    // changeColClassSize,\n    // formatButton: (btn, cmd) => document.execCommand(cmd, false, null),\n    // save,\n    // scrollToBlock: (id) => {\n    //   const block = document.getElementById(`block-${id}`);\n    //   if(block) { \n    //       block.scrollIntoView({ behavior: 'smooth', block: 'center' }); \n    //       selectBlock(block); \n    //   }\n\n    // }\n\n\n  };\n\n\n\n\n})();",
