d = false;\n\n\n  function config(data = {}) {\n\n      /**\n       * Restaurar padrões\n       */\n      editor = $.extend(\n          true,\n          {},\n          defaultEditor\n      );\n\n      /**\n       * Estado\n       */\n      if(\n          typeof data.isNew !== 'undefined'\n      ) {\n\n          state.isNew = data.isNew;\n\n      }\n\n      /**\n       * Configurações\n       */\n      if(data.editor) {\n\n          $.extend(\n              true,\n              editor,\n              data.editor\n          );\n\n      }\n\n  }\n\n\n\n  function destroy() {\n\n    /**\n     * Limpa canvas\n     */\n    $(selectors.canvas).empty();\n\n    /**\n     * Limpa painel lateral\n     */\n    $(selectors.settingsBlock).empty();\n\n    /**\n     * Limpa estrutura\n     */\n    $(selectors.structureList).empty();\n\n    /**\n     * Restaura state\n     */\n    state = $.extend(\n        true,\n        {},\n        defaultState\n    );\n\n    /**\n     * Restaura editor\n     */\n    editor = $.extend(\n        true,\n        {},\n        defaultEditor\n    );\n\n    console.log(\n        'Editor destruído'\n    );\n\n\n    interfaceInitialized = false;\n\n  }\n\n\n  function init(callback = null) {\n\n      /**\n       * Conteúdo\n       */\n\n      const id = Date.now();\n\n      const wrapper = document.createElement('div');\n\n      wrapper.id = `block-${id}`;\n      wrapper.className = 'automator-editor-block';\n      wrapper.classList.add('automator-editor-block-is-empty');\n      wrapper.classList.add('is-active');\n\n      wrapper.setAttribute('data-block-id', id);\n      wrapper.setAttribute('data-automator-default', \"true\");\n\n      state.activeBlock = wrapper;\n\n      let wrapperElement = `\n        <div class=\"automator-editor-block-render-area\" onclick=\"SysAutomatorEditor.deselectAll()\" data-empty=\"` + (editor.defalutEmpty.block || '') + `\">` + (editor.content || '') + `</div>\n        <div class=\"automator-editor-block-add-child-btn\">` + renderAddButton(id) + `</div>\n      `;\n      wrapper.innerHTML = wrapperElement;\n\n      wrapper.onclick = (e) => {\n\n        e.stopPropagation();\n        selectBlock(wrapper);\n\n      };\n\n      $(selectors.canvas).html(wrapper);\n      // var blockHTML = `\n        \n      //   <div id=\"block-${id}\" class=\"automator-editor-block automator-editor-block-is-empty\" data-block-id=\"${id}\">\n          \n      //     <div class=\"automator-editor-block-render-area\">` + (editor.content || '') + `</div>\n      //     <div class=\"automator-editor-block-add-child-btn\">` + renderAddButton(id) + `</div>\n\n      //   </div>\n\n      // `;\n      \n      // $(selectors.canvas).html(blockHTML);\n\n      // state.blockConfigs[id] = { can_have_child: true };\n      state.blockConfigs[id] = {\n\n          can_have_child: true,\n\n          is_root: true,\n\n          title: 'Página',\n\n          description: '',\n\n          icon: 'file',\n\n          properties: {}\n\n      };\n\n      /**\n       * Aba selecionada\n       */\n      if(\n          editor.settingsBlock &&\n          editor.settingsBlock.tab\n      ) {\n\n        if(editor.settingsBlock.collapsed == false) {\n          \n          $('#automator-editor-body-aside-right').removeClass('collapsed');\n\n        }\n        switchTab(editor.settingsBlock.tab);\n\n      }\n\n      if(callback != null) {\n\n        callback({\n\n          state,\n          editor,\n          selectors\n\n        })\n\n      } else {\n\n        return {\n\n            state,\n            editor,\n            selectors\n\n        };\n\n      }\n\n  }\n\n  \n\n  function initInterface(callback = null) {\n\n      console.log(\n          'initInterface'\n      );\n      if(interfaceInitialized){\n          return;\n      }\n\n      interfaceInitialized = true;\n\n      const popoverTriggerList = document.querySelectorAll('[data-bs-toggle=\"popover\"]')\n      const popoverList = [...popoverTriggerList].map(popoverTriggerEl => new bootstrap.Popover(popoverTriggerEl))\n\n      if(typeof callback === 'function') {\n\n        callback({\n            state,\n            editor,\n            selectors\n        });\n\n      }\n\n  }\n\n\n\n  function toggleSidebar(side) {\n\n\n    const id = '#automator-editor-body-aside-' + side;\n    $(id).toggleClass(window.innerWidth <= 991.98 ? 'show' : 'collapsed');\n\n\n  }\n\n\n\n  function switchLeftTab(tab) {\n\n    const sidebar = $('#automator-editor-body-aside-left');\n    const isCollapsed = sidebar.hasClass('collapsed');\n\n    if (isCollapsed) {\n\n      sidebar.removeClass('collapsed');\n      updateTabVisibility(tab);\n\n    } else {\n\n      const currentTabId = tab === 'inserter' ? '#automator-editor-body-aside-left-inserter' : '#automator-editor-body-aside-left-structure';\n      if ($(currentTabId).hasClass('d-none')) {\n        \n        sidebar.addClass('collapsed');\n        setTimeout(() => {\n\n          updateTabVisibility(tab);\n          sidebar.removeClass('collapsed');\n\n        }, 310);\n\n      } else {\n        \n        sidebar.addClass('collapsed');\n      \n      }\n    \n    }\n  \n\n  }\n\n\n\n  function updateTabVisibility(tab) {\n\n    if (tab === 'inserter') {\n\n      $('#automator-editor-body-aside-left-inserter').removeClass('d-none');\n      $('#automator-editor-body-aside-left-structure').addClass('d-none');\n\n    } else {\n\n      $('#automator-editor-body-aside-left-inserter').addClass('d-none');\n      $('#automator-editor-body-aside-left-structure').removeClass('d-none');\n      // updateStructureList();\n    \n    }\n\n  }\n\n\n\n  function updateStructureList() {\n  \n\n    const list = $(selectors.structureList);\n  \n    list.empty();\n    \n    function buildTree(container, level = 0) {\n\n      $(container).children('.wp-block').each(function() {\n\n        const id = this.getAttribute('block-id');\n        const isLocked = this.classList.contains('is-locked');\n        const config = state.blockConfigs[id] || {};\n        const title = config.title || `Bloco`;\n        const icon = config.icon || 'cube';\n\n        const item = $(`\n            <div class=\"structure-item d-flex align-items-center p-2 border-bottom\" block-id=\"${id}\" data-container-name=\"${config.title}\" style=\"padding-left: ${level * 20 + 10}px !important;\">\n                <i class=\"fas fa-grip-vertical structure-handle me-2 text-muted\"></i>\n                <i class=\"fa fa-${icon} me-2 small text-primary\"></i>\n                <span class=\"small flex-grow-1 text-truncate cursor-pointer\" onclick=\"SysAutomatorEditor.scrollToBlock('${id}')\">\n                    ${title} ${isLocked ? '<i class=\"fas fa-lock ms-1 text-warning\"></i>' : ''}\n                </span>\n                <button type=\"button\" class=\"btn btn-xs btn-light\" onclick=\"SysAutomatorEditor.toggleLock('${id}'); event.stopPropagation();\">\n                    <i class=\"fas ${isLocked ? 'fa-lock' : 'fa-lock-open'}\"></i>\n                </button>\n                <button type=\"button\" class=\"btn btn-xs btn-light text-danger ms-1\" onclick=\"SysAutomatorEditor.deleteBlock('${id}'); event.stopPropagation();\">\n                    <i class=\"fas fa-times\"></i>\n                </button>\n            </div>\n        `);\n        list.append(item);\n\n        const childArea = $(this).find('.wp-block-child-area').first();\n        if (childArea.length > 0) {\n          \n          buildTree(childArea, level + 1);\n        \n        }\n\n      });\n\n    }\n\n    buildTree(document.querySelector(selectors.canvas));\n\n    // Habilita Sortable na lista de estrutura para reordenação linear\n    if (list[0] && !list.hasClass('sortable-initialized')) {\n\n      new Sortable(list[0], {\n\n        animation: 150,\n        handle: '.structure-handle',\n        onEnd: function() {\n\n          const order = Array.from(list[0].children).map(el => el.dataset.id);\n          syncCanvasOrder(order);\n\n        }\n      });\n      \n      list.addClass('sortable-initialized');\n\n    }\n  \n\n  }\n\n\n  function addChildBlock(btn, block) {\n\n    if(event) event.stopPropagation();\n\n    let botao = $('#automator-editor-btn-child-' + block);\n\n    $('.automator-editor-body-canvas-content-add-button').removeClass('is-active');\n\n    if(state.activeBlock) state.activeBlock.classList.remove('is-active');\n    $(selectors.canvas).find('.automator-editor-block').removeClass('is-active');\n\n    let bloco = document.getElementById(`block-${block}`);\n    state.activeBlock = bloco;\n\n    if(state.activeBlock) {\n      state.activeBlock.classList.add('is-active');\n    }\n\n    botao.addClass('is-active');\n\n    const sidebar = $('#automator-editor-body-aside-left');\n    const isCollapsed = sidebar.hasClass('collapsed');\n\n    if(isCollapsed) {\n\n      switchLeftTab('inserter');\n\n    } else {\n\n      if($(selectors.inserterBlock).hasClass('d-none')) {\n\n        switchLeftTab('inserter');\n\n      }\n\n    }\n\n  }\n\n  // function addChildBlock(btn, block) {\n\n\n  //   console.log(state);\n  //   let botao = $('#automator-editor-btn-child-' + block);\n  //   if(botao.hasClass('is-active')) {\n\n  //     console.log('-----');\n  //     console.log(state);\n\n  //   } else {\n\n  //     $('.automator-editor-body-canvas-content-add-button').removeClass('is-active');\n  //     botao.addClass('is-active');\n\n  //     $('#automator-editor-body-canvas-content-container-render-area').find(\".automator-editor-block\").removeClass('is-active');\n  //     if(state.activeBlock == null) {\n\n  //       let bloco = document.getElementById(`block-${block}`);\n  //       state.activeBlock = bloco;\n  //       state.activeBlock.classList.add('is-active');\n\n  //     }\n\n  //   }\n  //   // switchLeftTab('inserter');\n\n  //   // console.log(block);\n  //   // console.log(state);\n  //   // console.log(bloco);\n  //   // if(state.activeBlock == null) {\n\n  //     // console.log(document.getElementById(`block-${block}`));\n  //     // console.log($('#block-' + block).attr('class'));\n  //     // state.activeBlock.classList.add('is-active');\n  //     // state.activeBlock = document.getElementById(`block-${block}`);\n  //     // let bloco = document.getElementById(`block-${block}`);\n  //     // state.activeBlock = bloco;\n  //     // state.activeBlock.classList.add('is-active');\n  //     // console.log($('#automator-editor-body-canvas-content-container-render-area').find('#block-' + block).html());\n  //     // $('#automator-editor-body-canvas-content-container-render-area').find('#block-' + block).addClass('is-active');\n\n  //   // } else {\n      \n  //     // if(state.activeBlock) state.activeBlock.classList.remove('is-active');\n  //     // $('#automator-editor-body-canvas-content-container-render-area').find(\".automator-editor-block\").removeClass('is-active');\n  //     // state.activeBlock.classList.remove('is-active');\n  //     // $('#automator-editor-body-canvas-content-container-render-area').find('#block-' + block).addClass('is-active');\n  //     // state.activeBlock = bloco;\n  //     // state.activeBlock.classList.add('is-active');\n\n  //   // }\n\n  //   // console.log(state.activeBlock);\n  //   // const sidebar = $('#automator-editor-body-aside-left');\n  //   // const isCollapsed = sidebar.hasClass('collapsed');\n\n  //   // if(isCollapsed) {\n\n  //     // switchLeftTab('inserter');\n  //     // switchLeftTab('inserter');\n  //     // updateTabVisibility('inserter');\n  //     // switchTab('inserter');\n\n  //   // }\n  //   // if($(selectors.).hasClass('collapsed')) {\n\n  //   //   SysAutomatorEditor.switchLeftTab('inserter');\n  //   // }\n\n  // }\n\n\n\n  function focusEditor(block, type) {\n\n    // let botao = $('#automator-editor-btn-child-' + block);\n\n    // $('.automator-editor-body-canvas-content-add-button').removeClass('is-active');\n\n    console.log(block);\n    if(state.activeBlock) state.activeBlock.classList.remove('is-active');\n    $(selectors.canvas).find('.automator-editor-block').removeClass('is-active');\n\n    let bloco = document.getElementById(`block-${block}`);\n    state.activeBlock = bloco;\n\n    if(state.activeBlock) {\n      state.activeBlock.classList.add('is-active');\n    }\n\n    var editor = $(selectors.canvas).find(\"#block-\" + block).find(\".automator-editor-block-render-area > \" + type);\n    editor.focus();\n\n  }\n\n\n  function selectBlock(block) {\n\n    if(!block) {\n        return;\n    }\n\n    if(state.activeBlock) {\n        state.activeBlock.classList.remove('is-active');\n    }\n\n    state.activeBlock = block;\n    state.activeBlock.classList.add('is-active');\n\n    const id = block.getAttribute('data-block-id');\n    const field = state.blockConfigs[id];\n\n    if(\n        field &&\n        field.properties\n    ) {\n\n        renderBlockSettings(\n            block,\n            id,\n            field\n        );\n\n    } else {\n\n        const defaultButton = $(selectors.rightArea)\n            .find('.automator-editor-body-aside-right-tabs-button[data-automator-default=\"true\"]');\n\n        defaultButton.trigger('click');\n\n    }\n\n  }\n\n  // function selectBlock(block) {\n\n  //   if(state.activeBlock) state.activeBlock.classList.remove('is-active');\n  //   state.activeBlock = block;\n  //   state.activeBlock.classList.add('is-active');\n    \n  //   const id = block.getAttribute('data-block-id');\n  //   const field = state.blockConfigs[id];\n    \n  //   // if (field && field.can_have_child) {\n  //   //     switchLeftTab('inserter');\n  //   // }\n    \n  //   renderBlockSettings(block, id, field);\n  \n  // }\n\n\n\n  function insertField(fieldID) {\n    \n\n    if (typeof AutomatorGetActionStatus === 'function') {\n    \n      AutomatorGetActionStatus(() => includeField(fieldID));\n    \n    } else {\n    \n      includeField(fieldID);\n    \n    }\n\n\n  }\n\n\n  function includeField(fieldID) {\n\n\n    AutomatorSetActionStatus(true, () => {\n      \n      AutomatorPageLoader('show', () => {\n        \n        $.ajax({\n\n          url:     window.AutomatorRoutes.apiEditor || '',\n          type:    'POST',\n          headers: { 'X-CSRF-TOKEN': $('meta[name=\"csrf-token\"]').attr('content'), 'Accept': 'application/json' },\n          data:    { fieldTypeID: fieldID },\n          success: function(response) {\n            \n            AutomatorPageLoader('hide', () => {\n\n              AutomatorSetActionStatus(false, () => {\n\n                if(response.status == true) {\n\n                  if(response.automator) injectBlock(response.automator);\n\n                }\n\n              });\n\n            });\n\n\n          },\n          error: function() {\n\n            AutomatorPageLoader('hide', () => AutomatorSetActionStatus(false));\n            alert('Erro ao carregar campo.');\n\n          }\n\n        });\n\n      });\n\n    });\n\n\n  }\n\n\n  function injectBlock(field) {\n\n    const id = Date.now();\n    state.blockConfigs[id] = JSON.parse(JSON.stringify(field));\n\n    const wrapper = document.createElement('div');\n    wrapper.id = `block-${id}`;\n    wrapper.className = 'automator-editor-block';\n\n    if (field.can_have_child) {\n      wrapper.classList.add('automator-editor-block-can-have-childs', 'automator-editor-block-is-empty');\n    }\n\n    if (field.class) {\n      wrapper.classList.add('' + field.class);\n    }\n\n    wrapper.setAttribute('data-block-id', id);\n    wrapper.setAttribute('data-block-name', field.title);\n\n    let props = field.props;\n    if(Object.keys(props).length >= 1) {\n      $.each(props, function(propKey, propVal) {\n        wrapper.setAttribute('data-block-' + propKey, propVal);\n      });\n    }\n\n    let wrapperElement = renderFieldElement(id, field);\n    wrapper.innerHTML = wrapperElement;\n\n    wrapper.onclick = (e) => {\n\n      e.stopPropagation();\n\n      const current = e.currentTarget;\n\n      selectBlock(current);\n      // e.stopPropagation();\n      // selectBlock(wrapper);\n    };\n\n    // Determina o container de destino correto\n    let targetContainer;\n\n    if (state.activeBlock) {\n\n      const activeId     = state.activeBlock.getAttribute('data-block-id');\n      const activeConfig = state.blockConfigs[activeId];\n\n      if (activeConfig && activeConfig.can_have_child) {\n\n        // Busca o render-area DIRETO do bloco ativo (não de todos do canvas)\n        targetContainer = $(state.activeBlock).find('.automator-editor-block-render-area').first();\n        $(state.activeBlock).removeClass('automator-editor-block-is-empty');\n\n      } else {\n\n        // Bloco ativo não aceita filhos — insere no container raiz\n        // targetContainer = $(selectors.canvas);\n        targetContainer = $(selectors.canvas).find('.automator-editor-block').first();\n\n      }\n\n    } else {\n\n      // Sem bloco ativo — insere no container raiz\n      // targetContainer = $(selectors.canvas);\n      targetContainer = $(selectors.canvas).find('.automator-editor-block').first();\n\n    }\n\n    targetContainer.append(wrapper);\n\n    AutomatorInitBootstrapTooltips();\n    switchLeftTab('inserter');\n    selectBlock(wrapper);\n    if(field.editor == true) {\n\n      focusEditor(id, field.tag);\n\n    }\n\n    console.log(state);\n    state.hasChanges = true;\n\n  }\n  // function injectBlock(field) {\n\n\n  //   const id = Date.now();\n  //   state.blockConfigs[id] = JSON.parse(JSON.stringify(field));\n\n\n  //   const wrapper = document.createElement('div');\n\n  //   wrapper.id = `block-${id}`;\n\n    \n  //   wrapper.className = 'automator-editor-block';\n\n  //   if (field.can_have_child) {\n\n  //     wrapper.classList.add('automator-editor-block-can-have-childs', 'automator-editor-block-is-empty')\n\n  //   };\n\n\n  //   if (field.class) {\n\n  //     wrapper.classList.add('' + field.class);\n\n  //   };\n    \n\n  //   wrapper.setAttribute('data-block-id', id);\n  //   wrapper.setAttribute('data-block-name', field.title);\n\n\n  //   let props = field.props;\n\n  //   if( (Object.keys(props).length) >= 1) {\n\n  //     $.each(props, function(propKey, propVal) {\n\n  //       wrapper.setAttribute('data-block-' + propKey, propVal);\n\n  //     });\n\n  //   }\n\n\n\n  //   let wrapperElement = renderFieldElement(id, field);\n\n  //   wrapper.innerHTML = wrapperElement;\n\n\n  //   wrapper.onclick = (e) => { \n\n  //     e.stopPropagation();\n  //     selectBlock(wrapper);\n\n  //   };\n\n\n  //   let targetContainer = $(selectors.canvas).find('.automator-editor-block').first();\n\n    \n  //   if (state.activeBlock) {\n\n  //     const activeId     = state.activeBlock.getAttribute('data-block-id');\n  //     const activeConfig = state.blockConfigs[activeId];\n  //     if (activeConfig && activeConfig.can_have_child) {\n\n  //       $(state.activeBlock).removeClass('automator-editor-block-is-empty');\n  //       targetContainer = $(selectors.canvas).find('.automator-editor-block-render-area');\n  //       // targetContainer = $(state.activeBlock).find('.automator-editor-block-render-area').first();\n      \n  //     }\n    \n  //   } else {\n\n  //     console.log(state.blockConfigs);\n  //     const activeId     = targetContainer.attr('data-block-id');\n  //     const activeConfig = state.blockConfigs[activeId];\n\n  //     console.log(activeConfig);\n  //     if (activeConfig && activeConfig.can_have_child) {\n\n  //       targetContainer.removeClass('automator-editor-block-is-empty');\n  //       targetContainer = targetContainer.find('.automator-editor-block-render-area');\n  //       // targetContainer = $(state.activeBlock).find('.automator-editor-block-render-area').first();\n      \n  //     }\n\n  //   }\n\n  //   targetContainer.append(wrapper);\n        \n  //   // if (field.can_have_child) {\n  //   //     initSortable(wrapper.querySelector('.wp-block-child-area'));\n  //   // }\n  //   AutomatorInitBootstrapTooltips();\n  //   selectBlock(wrapper);\n  //   // updateStructureList();\n  //   state.hasChanges = true;\n\n\n  // }\n\n\n\n  function renderFieldElement(id, field) {\n\n\n\n    let toolbarHTML = '';\n    let toolbarHTMLC = 0;\n\n    field.toolbar.forEach(btn => {\n      \n      toolbarHTML += `<button type=\"${btn.type || 'button'}\" class=\"${btn.class}\" data-bs-toggle=\"tooltip\" data-bs-title=\"${btn.title}\" onclick=\"${btn.onclick}\">${btn.label}</button>`;\n      toolbarHTMLC++;\n\n    });\n\n    \n    var renderArea  = '<div class=\"automator-editor-block-handle\"><i class=\"fas fa-grip-vertical\"></i></div>' + \"\\n\";\n        renderArea += '<div class=\"automator-editor-block-toolbar\">' + \"\\n\";\n          \n          if(toolbarHTMLC >= 1) {\n\n            renderArea += `${toolbarHTML}` + \"\\n\";\n            renderArea += '<div class=\"vr mx-1\"></div>' + \"\\n\";\n\n          }\n          renderArea += `<button type=\"button\" class=\"btn btn-xs btn-light border\" onclick=\"SysAutomatorEditor.moveBlock('${id}', 'up')\" data-bs-toggle=\"tooltip\" data-bs-title=\"Mover para cima\"><i class=\"fas fa-chevron-up\"></i></button>` + \"\\n\";\n          renderArea += `<button type=\"button\" class=\"btn btn-xs btn-light border\" onclick=\"SysAutomatorEditor.moveBlock('${id}', 'down')\" data-bs-toggle=\"tooltip\" data-bs-title=\"Mover para baixo\"><i class=\"fas fa-chevron-down\"></i></button>` + \"\\n\";\n          renderArea += '<div class=\"vr mx-1\"></div>' + \"\\n\";\n          renderArea += `<button type=\"button\" id=\"automator-editor-lock-btn-${id}\" onclick=\"SysAutomatorEditor.toggleLock('${id}')\" class=\"btn btn-xs btn-light border lock-btn\" data-bs-toggle=\"tooltip\" data-bs-title=\"Travar/Destravar Campo\"><i class=\"fas fa-lock-open\"></i></button>` + \"\\n\";\n          renderArea += `<button type=\"button\" class=\"btn btn-xs btn-light border text-danger\" onclick=\"SysAutomatorEditor.deleteBlock('${id}')\" data-bs-toggle=\"tooltip\" data-bs-title=\