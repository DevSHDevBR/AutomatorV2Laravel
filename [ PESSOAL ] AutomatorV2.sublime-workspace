= block.id; // Adicionar o ID gerado aos atributos\n        $.each(this.attributes, function() {\n          if (this.name !== 'class' && this.name !== 'id') { // Excluir o ID original se existir\n            \n            block.attributes[this.name] = this.value;\n          \n          } else if (this.name === 'class') {\n\n            // Manter outras classes, se houver\n            const otherClasses = $.grep(this.value.split(' '), function(c) { return c !== 'automator-editor-block'; });\n            if (otherClasses.length > 0) {\n                block.attributes[this.name] = otherClasses.join(' ');\n            }\n          }\n\n        });\n\n        // Extrair conteúdo interno ou filhos aninhados\n        const $innerContent = $this.clone();\n        $innerContent.children(\".automator-editor-block\").remove(); // Remover filhos para pegar apenas o conteúdo direto\n        block.content = $innerContent.html().trim();\n\n        // Recursivamente extrair filhos\n        block.children = extractBlockStructure($this);\n\n        structure.push(block);\n    });\n\n    return structure;\n  }\n\n\n  function initAllSortables() {\n\n      $(selectors.canvas)\n          .find('.automator-editor-block-child-area')\n          .each(function() {\n\n              initSortable(this);\n\n          });\n\n  }\n\n\n  function initInterface(callback = null) {\n\n\n    console.log('Editor interface start!');\n\n    if(interfaceInitialized){ return; }\n\n    interfaceInitialized = true;\n\n    const popoverTriggerList = document.querySelectorAll('[data-bs-toggle=\"popover\"]')\n    const popoverList = [...popoverTriggerList].map(popoverTriggerEl => new bootstrap.Popover(popoverTriggerEl))\n\n    // restoreCurrentResolutionSize();\n\n    // initSortable(document.querySelector('.automator-editor-block-render-area'));\n    // $('.automator-editor-block-child-area').each(function() {\n\n    //   initSortable(this);\n\n    // });\n\n    initAllSortables();\n\n    // console.log(state